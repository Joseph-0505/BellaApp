# Ambiente 
NODE_ENV=development
LOG_LEVEL=info

# Servidor
PORT=3000
HOST=0.0.0.0

# Banco de dados
DATABASE_URL="mysql://root:CHANGE_ME@mysql:3306/bellaapp"

# Redis (cache distribuido e Pub/Sub)
REDIS_URL=redis://redis:6379
REDIS_ENABLED=true
CACHE_DEFAULT_TTL_SECONDS=60
CACHE_APPOINTMENTS_TTL_SECONDS=20
PUBSUB_ENABLED=true
PUBSUB_CHANNEL=bellaapp:domain-events

# JWT 
JWT_SECRET=CHANGE_ME_use_um_valor_aleatorio_de_no_minimo_16_caracteres

# Expiracao do token
JWT_EXPIRES_IN=1d

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Arquivos enviados pelos usuarios
UPLOAD_DIR=uploads
