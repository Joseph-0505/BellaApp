#!/bin/sh
commit_msg=$(cat "$1")

# Permite mensagens de merge do GitFlow
if echo "$commit_msg" | grep -qE "^Merge branch '"; then
  exit 0
fi

pattern='^(feat|fix|chore|docs|style|refactor|test|build|ci|perf|revert)(\([a-z0-9/_-]+\))?: .+'
jira_pattern='KAN-[0-9]+'

if ! echo "$commit_msg" | grep -qE "$pattern"; then
  echo ""
  echo "Mensagem de commit invalida!"
  echo "Use o formato: tipo(escopo): descricao"
  echo "Tipos validos: feat, fix, chore, docs, style, refactor, test, build, ci, perf, revert"
  echo "Exemplo: feat(auth): adiciona login"
  echo ""
  exit 1
fi

if ! echo "$commit_msg" | grep -qiE "$jira_pattern"; then
  echo ""
  echo "A mensagem deve referenciar uma issue Jira (ex.: KAN-53)."
  echo "Exemplo: fix(auth): KAN-53 redireciona sessao expirada"
  echo ""
  exit 1
fi
