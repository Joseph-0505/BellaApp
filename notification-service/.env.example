NODE_ENV=development
LOG_LEVEL=info
HOST=0.0.0.0
PORT=3001

REDIS_URL=redis://localhost:6379
QUEUE_STREAM=bellaapp:notifications
QUEUE_GROUP=bellaapp:notification-workers
QUEUE_DEAD_LETTER_STREAM=bellaapp:notifications:dead-letter
QUEUE_BLOCK_MS=2000
QUEUE_BATCH_SIZE=10
QUEUE_PENDING_IDLE_MS=10000
NOTIFICATION_MAX_ATTEMPTS=3

DOMAIN_EVENTS_ENABLED=true
PUBSUB_CHANNEL=bellaapp:domain-events

# Em log, e-mails sao renderizados no log sem envio externo.
MAIL_DELIVERY_MODE=log
MAIL_FROM_EMAIL=no-reply@bellaapp.local
MAIL_FROM_NAME=BellaApp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
